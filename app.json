{
  "expo": {
    "name": "Axtar.az",
    "slug": "axtaraz-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "az.axtar.mobile"
    },
    "android": {
      "package": "az.axtar.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/axtar-app-icon-foreground.png",
        "backgroundColor": "#FFF9F7"
      }
    },
    "icon": "./assets/images/axtar-app-icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/axtar-app-icon-foreground.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9F7"
        }
      ]
    ]
  }
}
